{
  "name": "keeply",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "wait-on": "wait-on tcp:4200",
    "build:main": "tsc -p source/main/tsconfig.json",
    "electron": "electron ./dist/main/main.js --dev",
    "start": "concurrently \"ng serve\" \"npm run wait-on && npm run build:main && npm run electron\"",
    "build": "ng build && npm run build:main",
    "test": "ng test",
    "serve:ssr:keeply": "node dist/keeply/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.10",
    "@angular/cdk": "^19.2.15",
    "@angular/common": "^19.2.10",
    "@angular/compiler": "^19.2.10",
    "@angular/core": "^19.2.10",
    "@angular/forms": "^19.2.10",
    "@angular/platform-browser": "^19.2.10",
    "@angular/platform-browser-dynamic": "^19.2.10",
    "@angular/platform-server": "^19.2.10",
    "@angular/router": "^19.2.10",
    "@angular/ssr": "^19.2.11",
    "@ngrx/operators": "^19.2.0",
    "@ngrx/signals": "^19.2.0",
    "@primeng/themes": "^19.1.3",
    "express": "^4.18.2",
    "primeng": "^19.1.3",
    "rxjs": "~7.8.0",
    "rxjs-interop": "^2.0.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.11",
    "@angular/cli": "^19.2.11",
    "@angular/compiler-cli": "^19.2.10",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-split": "^18.0.0",
    "concurrently": "^9.1.2",
    "electron": "^35.1.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "kdbxweb": "^2.1.1",
    "typescript": "~5.5.2",
    "wait-on": "^8.0.3"
  }
}
